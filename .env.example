# Copy to .env (never commit .env)
PORT=8000
DATABASE_URL=file:./tasks.db
# Secret for signing the JWT. Any text works in development; production refuses "dev-secret".
JWT_SECRET=change-me
# development | test | production
APP_ENV=development
# registering with this email makes the user an admin (Bonus 9). Leave empty for no admin.
ADMIN_EMAIL=
# where Deno KV keeps the task cache (Bonus 16)
KV_PATH=./kv.db
# where uploaded images go (Bonus 12)
UPLOAD_DIR=./uploads
# number of database connections in the pool (Bonus 6)
DB_POOL_SIZE=4
